{
  "name": "policychecks",
  "version": "0.6.1",
  "description": "A badge service for reporting selected GitHub repository administration settings from GitHub API responses",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/app.ts",
    "dev:fixtures": "tsx src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "check-updates": "if [ \"$CI\" = \"true\" ]; then echo 'Skipping dependency update notifier in CI.'; else npx npm-check-updates --enginesNode; fi",
    "check-updates:update": "npx npm-check-updates --enginesNode -u",
    "deploy": "wrangler deploy -c wrangler.policychecks.jsonc",
    "deploy:preview": "wrangler versions upload -c wrangler.policychecks.jsonc",
    "deploy:policychecks": "wrangler deploy -c wrangler.policychecks.jsonc",
    "prepare": "husky"
  },
  "keywords": [
    "security",
    "repository-administration",
    "repository-settings",
    "badge",
    "supply-chain",
    "best-practices"
  ],
  "author": {
    "name": "Reponomics Contributors",
    "email": "policychecks@reponomics.org"
  },
  "license": "MIT",
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "dotenv": "^18.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260918.1": true
  }
}
